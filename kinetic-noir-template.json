     }\r\n    \u003c/style\u003e\r\n\u003c/head\u003e\r\n\r\n\u003cbody class=\"selection:bg-primary selection:text-on-primary\"\u003e\r\n    \u003c!-- TopNavBar --\u003e\r\n    \u003cnav class=\"fixed top-0 w-full z-50 bg-neutral-950/70 backdrop-blur-xl shadow-[0_0_60px_rgba(156,255,147,0.05)]\"\u003e\r\n        \u003cdiv class=\"flex justify-between items-center px-6 md:px-12 py-6 max-w-[1920px] mx-auto\"\u003e\r\n            \u003cdiv class=\"text-2xl font-black text-white tracking-tighter uppercase font-headline\"\u003eKINETIC NOIR\u003c/div\u003e\r\n            \u003c!-- Desktop Links --\u003e\r\n            \u003cdiv class=\"hidden md:flex gap-12 items-center\"\u003e\r\n                \u003ca class=\"font-[\u0027Space_Grotesk\u0027] uppercase tracking-[0.1em] font-bold text-white hover:text-[#9cff93] transition-colors duration-300\"\r\n                    href=\"#\"\u003ePROGRAMS\u003c/a\u003e\r\n                \u003ca class=\"font-[\u0027Space_Grotesk\u0027] uppercase tracking-[0.1em] font-bold text-white hover:text-[#9cff93] transition-colors duration-300\"\r\n                    href=\"#\"\u003eCURRICULUM\u003c/a\u003e\r\n                \u003ca class=\"font-[\u0027Space_Grotesk\u0027] uppercase tracking-[0.1em] font-bold text-white hover:text-[#9cff93] transition-colors duration-300\"\r\n                    href=\"#\"\u003eTRAINERS\u003c/a\u003e\r\n                \u003ca class=\"font-[\u0027Space_Grotesk\u0027] uppercase tracking-[0.1em] font-bold text-white hover:text-[#9cff93] transition-colors duration-300\"\r\n                    href=\"#\"\u003eENROLL\u003c/a\u003e\r\n            \u003c/div\u003e\r\n            \u003cbutton\r\n                class=\"bg-[#9cff93] text-[#006413] px-6 py-3 font-headline font-bold text-sm tracking-widest uppercase hover:bg-[#00ec3b] transition-all scale-95 active:duration-100\"\u003e\r\n                GET STARTED\r\n            \u003c/button\u003e\r\n        \u003c/div\u003e\r\n    \u003c/nav\u003e\r\n    \u003cmain\u003e\r\n        \u003c!-- Hero Section --\u003e\r\n        \u003csection\r\n            class=\"relative min-height-[1024px] pt-40 pb-24 md:pt-64 md:pb-40 px-6 md:px-12 overflow-hidden flex flex-col justify-center\"\u003e\r\n            \u003c!-- Background Decorative Element --\u003e\r\n            \u003cdiv\r\n                class=\"absolute top-0 right-0 w-2/3 h-full bg-gradient-to-bl from-primary/10 to-transparent -z-10 blur-3xl\"\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class=\"max-w-[1400px] mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-end\"\u003e\r\n                \u003cdiv class=\"lg:col-span-8\"\u003e\r\n                    \u003cspan class=\"font-headline text-primary tracking-[0.3em] font-bold uppercase mb-6 block\"\u003eKINETIC\r\n                        NOIR ACADEMY\u003c/span\u003e\r\n                    \u003ch1 class=\"text-6xl md:text-[10rem] font-black leading-[0.85] tracking-tighter font-headline mb-12\"\u003e\r\n                        MASTER THE \u003cbr /\u003e\r\n                        \u003cspan class=\"text-primary\"\u003eKINETIC\u003c/span\u003e FLOW\r\n                    \u003c/h1\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"lg:col-span-4 glass-card p-10 border-l-4 border-primary\"\u003e\r\n                    \u003cp class=\"text-on-surface-variant body-lg mb-8 leading-relaxed\"\u003e\r\n                        Precision engineering meets raw creativity. Join the agency-led training program designed for\r\n                        the next generation of digital disruptors.\r\n                    \u003c/p\u003e\r\n                    \u003cdiv class=\"flex flex-col gap-4\"\u003e\r\n                        \u003cbutton\r\n                            class=\"w-full bg-primary text-on-primary py-5 font-headline font-bold tracking-widest uppercase hover:bg-primary-dim transition-all\"\u003e\r\n                            ENROLL NOW\r\n                        \u003c/button\u003e\r\n                        \u003cbutton\r\n                            class=\"w-full border border-outline/20 text-white py-5 font-headline font-bold tracking-widest uppercase hover:bg-white/5 transition-all\"\u003e\r\n                            VIEW CURRICULUM\r\n                        \u003c/button\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n            \u003c/div\u003e\r\n        \u003c/section\u003e\r\n        \u003c!-- Curriculum Section --\u003e\r\n        \u003csection class=\"py-32 px-6 md:px-12 bg-surface-container-low\"\u003e\r\n            \u003cdiv class=\"max-w-[1400px] mx-auto\"\u003e\r\n                \u003cdiv class=\"flex flex-col md:flex-row justify-between items-end mb-24 gap-8\"\u003e\r\n                    \u003cdiv class=\"max-w-2xl\"\u003e\r\n                        \u003ch2 class=\"text-4xl md:text-6xl font-headline font-black tracking-tighter mb-6 uppercase\"\u003eTHE\r\n                            CURRICULUM\u003c/h2\u003e\r\n                        \u003cdiv class=\"h-1 w-24 bg-primary mb-6\"\u003e\u003c/div\u003e\r\n                        \u003cp class=\"text-on-surface-variant text-xl\"\u003eAn intensive 12-week journey through the core pillars\r\n                            of high-performance digital output.\u003c/p\u003e\r\n                    \u003c/div\u003e\r\n                    \u003cdiv class=\"text-primary font-headline text-8xl font-black opacity-10 leading-none hidden md:block\"\u003e\r\n                        MODULES\u003c/div\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-0\"\u003e\r\n                    \u003c!-- Module 1 --\u003e\r\n                    \u003cdiv\r\n                        class=\"group p-12 bg-surface hover:bg-surface-container-high transition-all border-b md:border-b-0 md:border-r border-outline-variant/30 flex flex-col justify-between aspect-square\"\u003e\r\n                        \u003cspan class=\"material-symbols-outlined text-primary text-5xl\"\r\n                            data-icon=\"brand_awareness\"\u003ebrand_awareness\u003c/span\u003e\r\n                        \u003cdiv\u003e\r\n                            \u003ch3 class=\"text-2xl font-headline font-bold mb-4 uppercase\"\u003eBrand Strategy\u003c/h3\u003e\r\n                            \u003cp class=\"text-on-surface-variant mb-8\"\u003eArchitecting brand identities that cut through the\r\n                                noise of the modern digital landscape.\u003c/p\u003e\r\n                            \u003ca class=\"text-primary font-headline font-bold tracking-widest text-sm flex items-center gap-2 hover:translate-x-2 transition-transform\"\r\n                                href=\"#\"\u003e\r\n                                EXPLORE \u003cspan class=\"material-symbols-outlined text-sm\"\r\n                                    data-icon=\"arrow_forward\"\u003earrow_forward\u003c/span\u003e\r\n                            \u003c/a\u003e\r\n                        \u003c/div\u003e\r\n                    \u003c/div\u003e\r\n                    \u003c!-- Module 2 --\u003e\r\n                    \u003cdiv\r\n                        class=\"group p-12 bg-surface hover:bg-surface-container-high transition-all border-b md:border-b-0 md:border-r border-outline-variant/30 flex flex-col justify-between aspect-square\"\u003e\r\n                        \u003cspan class=\"material-symbols-outlined text-primary text-5xl\" data-icon=\"palette\"\u003epalette\u003c/span\u003e\r\n                        \u003cdiv\u003e\r\n                            \u003ch3 class=\"text-2xl font-headline font-bold mb-4 uppercase\"\u003eCreative Direction\u003c/h3\u003e\r\n                            \u003cp class=\"text-on-surface-variant mb-8\"\u003eVisual storytelling using Precision Brutalism\r\n                                principles and high-voltage design systems.\u003c/p\u003e\r\n                            \u003ca class=\"text-primary font-headline font-bold tracking-widest text-sm flex items-center gap-2 hover:translate-x-2 transition-transform\"\r\n                                href=\"#\"\u003e\r\n                                EXPLORE \u003cspan class=\"material-symbols-outlined text-sm\"\r\n                                    data-icon=\"arrow_forward\"\u003earrow_forward\u003c/span\u003e\r\n                            \u003c/a\u003e\r\n                        \u003c/div\u003e\r\n                    \u003c/div\u003e\r\n                    \u003c!-- Module 3 --\u003e\r\n                    \u003cdiv\r\n                        class=\"group p-12 bg-surface hover:bg-surface-container-high transition-all border-outline-variant/30 flex flex-col justify-between aspect-square\"\u003e\r\n                        \u003cspan class=\"material-symbols-outlined text-primary text-5xl\"\r\n                            data-icon=\"terminal\"\u003eterminal\u003c/span\u003e\r\n                        \u003cdiv\u003e\r\n                            \u003ch3 class=\"text-2xl font-headline font-bold mb-4 uppercase\"\u003eDigital Engineering\u003c/h3\u003e\r\n                            \u003cp class=\"text-on-surface-variant mb-8\"\u003eBridging the gap between design and\r\n                                high-performance, accessible codebases.\u003c/p\u003e\r\n                            \u003ca class=\"text-primary font-headline font-bold tracking-widest text-sm flex items-center gap-2 hover:translate-x-2 transition-transform\"\r\n                                href=\"#\"\u003e\r\n                                EXPLORE \u003cspan class=\"material-symbols-outlined text-sm\"\r\n                                    data-icon=\"arrow_forward\"\u003earrow_forward\u003c/span\u003e\r\n                            \u003c/a\u003e\r\n                        \u003c/div\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n            \u003c/div\u003e\r\n        \u003c/section\u003e\r\n        \u003c!-- Trainers Section --\u003e\r\n        \u003csection class=\"py-32 px-6 md:px-12 bg-surface\"\u003e\r\n            \u003cdiv class=\"max-w-[1400px] mx-auto\"\u003e\r\n                \u003cdiv class=\"mb-24\"\u003e\r\n                    \u003ch2 class=\"text-4xl md:text-6xl font-headline font-black tracking-tighter uppercase\"\u003eTHE TRAINERS\r\n                    \u003c/h2\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8\"\u003e\r\n                    \u003c!-- Trainer 1 --\u003e\r\n                    \u003cdiv class=\"group relative overflow-hidden aspect-[3/4]\"\u003e\r\n                        \u003cimg alt=\"Lead Instructor Profile\"\r\n                            class=\"w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700\"\r\n                            data-alt=\"Portrait of a male creative director in dark techwear, looking confidently at camera, dramatic studio lighting on dark background\"\r\n                            src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCI7NIXh7ococgpZwHi9PcXFLYhdPwTcUZyCMQxqotpFXSW1iAeXsZt4x6w0sAVKTSKlin7HqupQ7z8InSlr2WoJ-Gub0BZGHOHBODcicBHWEke0ZO-LmD_JNI__gWyA0CcF1dY2ZHe7FWjHuxeAYoUbehCYxYcwG6rtY-UrBBZB5UuXB2TyQMGcsX7jSuqcQof4zQEAiMWAQXJUAWj9F4NyYR9eIXiZvciFE2twYTGUBBXF5ifLw9jQM7sV_63lcKfItG01KHbJiY\" /\u003e\r\n                        \u003cdiv class=\"absolute bottom-0 left-0 w-full p-8 glass-card\"\u003e\r\n                            \u003ch4 class=\"font-headline font-bold text-xl uppercase\"\u003eMARCUS VANCE\u003c/h4\u003e\r\n                            \u003cp class=\"text-primary font-headline text-xs tracking-widest uppercase\"\u003eHEAD OF DESIGN\u003c/p\u003e\r\n                        \u003c/div\u003e\r\n                    \u003c/div\u003e\r\n                    \u003c!-- Trainer 2 --\u003e\r\n                    